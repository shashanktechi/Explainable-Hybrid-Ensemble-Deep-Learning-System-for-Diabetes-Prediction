{
  "info": {
    "name": "XAI-HEDL Backend API - Local Smoke and Access Tests",
    "description": "Local disposable-database API checks. Run only against the isolated Postman test server started from the README instructions. Uses synthetic test accounts and patient data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "adminEmail",
      "value": "postman-admin@example.test"
    },
    {
      "key": "adminPassword",
      "value": "Postman-Test-Only-2026!"
    },
    {
      "key": "doctorEmail",
      "value": "postman-doctor@example.com"
    },
    {
      "key": "doctorPassword",
      "value": "Postman-Doctor-Only-2026!"
    },
    {
      "key": "expectedExplanation",
      "value": "stub"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('health and database are connected', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().db).to.eql('connected'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "OpenAPI route inventory",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/openapi.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('OpenAPI schema includes all custom backend routes', function () { pm.response.to.have.status(200); var paths = Object.keys(pm.response.json().paths); [\"/api/health\",\"/api/auth/login\",\"/api/auth/me\",\"/api/auth/register\",\"/api/auth/verify-email\",\"/api/auth/resend-verification\",\"/api/auth/forgot-password\",\"/api/auth/reset-password\",\"/api/auth/password\",\"/api/auth/users\",\"/api/patients\",\"/api/patients/{patient_id}\",\"/api/patients/{patient_id}/records\",\"/api/patients/{patient_id}/predictions\",\"/api/predict\",\"/api/predictions\",\"/api/predictions/{prediction_id}\",\"/api/models\",\"/api/audit\"].forEach(function (path) { pm.expect(paths).to.include(path); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Registration requires mail and rejects verified duplicate",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"full_name\":\"Postman Test Doctor\",\"email\":\"{{doctorEmail}}\",\"password\":\"{{doctorPassword}}\",\"hospital_name\":\"Local Test Hospital\"}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('registration fails closed or rejects an already verified address', function () { pm.expect([409,503]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify email rejects unknown challenge",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"unknown@example.com\",\"otp\":\"123456\"}"
        },
        "url": "{{baseUrl}}/api/auth/verify-email"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('email verification rejects absent and invalid codes', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Resend verification requires configured mail",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"unknown@example.com\"}"
        },
        "url": "{{baseUrl}}/api/auth/resend-verification"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('resend is generic and never claims an unavailable send succeeded', function () { pm.expect([200,503]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Forgot password requires configured mail",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"unknown@example.com\"}"
        },
        "url": "{{baseUrl}}/api/auth/forgot-password"
