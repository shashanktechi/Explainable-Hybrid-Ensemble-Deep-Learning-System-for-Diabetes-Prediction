              "pm.test('deleted patient is no longer accessible', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Password change code requires SMTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/password-change-otp"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('password change code is not claimed sent without SMTP', function () { pm.response.to.have.status(503); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Password change rejects invalid OTP",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"current_password\":\"{{doctorPassword}}\",\"new_password\":\"Postman-Updated-Only-2026!\",\"otp\":\"000000\"}"
        },
        "url": "{{baseUrl}}/api/auth/password"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('password change requires a valid one-time email code', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Doctor token remains valid after rejected password change",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('rejected password change does not revoke the session', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
