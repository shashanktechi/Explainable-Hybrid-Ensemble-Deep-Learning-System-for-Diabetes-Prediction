# ============================================================
# XAI-HEDL  –  Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real credentials.
# ============================================================

# === Database ===
# Option A – AWS RDS MySQL (production / staging)
DATABASE_URL=mysql+pymysql://YOUR_RDS_USER:YOUR_RDS_MASTER_PASSWORD@YOUR_RDS_HOST:3306/YOUR_DATABASE_NAME

# Option B – Local SQLite (quick local dev, no MySQL needed)
# DATABASE_URL=sqlite:///./local.db

# Option C – Supabase PostgreSQL (legacy; kept for reference)
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@<host>:6543/postgres?sslmode=require

# === JWT Auth ===
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Email OTP (Gmail example: use an app password, never your account password) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=replace-with-a-new-google-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com
OTP_HASH_SECRET=replace-with-a-separate-long-random-secret
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# === CORS ===
CORS_ORIGINS=http://localhost:5173

# === ML Model ===
MODEL_VERSION=pima-v1
USE_STUB_MODEL=false
MODEL_ARTIFACT_PATH=ml/saved_models/pima-v1/xai_hedl.joblib

# === Logging ===
LOG_LEVEL=INFO

# === Testing (optional — SQLite keeps CI free of real DB credentials) ===
# TEST_DATABASE_URL=sqlite:///./test.db
